<?xml version="1.0"?>
<ruleset name="GitHub Theme Updater">

	<description>WordPress coding standards for the GitHub Theme Updater plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<!-- WordPress core classes vendored for the tests; not ours to lint. -->
	<exclude-pattern>/tests/fixtures/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- The plugin uses a namespace, so the file name/class name coupling is
		     handled by its own autoloader rather than by WordPress conventions. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="github-theme-updater"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gthu"/>
				<element value="MSM\GitHubThemeUpdater"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		Tests are plain PHPUnit: PSR-4 file names, self-describing method names
		instead of docblocks, and stubs of WordPress functions in the bootstrap.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<!-- The filesystem tests build fixtures with plain PHP on purpose: the code under test is the WP_Filesystem layer itself. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

</ruleset>
