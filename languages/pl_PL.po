msgstr "[%s] Wiadomość testowa z GitHub Theme Updater"

#. translators: %s: site URL.
#: includes/class-notifier.php:274
#, php-format
msgid ""
"This is a test. Reports about automatic theme updates on %s will be sent to "
"this address."
msgstr ""
"To jest test. Raporty o automatycznych aktualizacjach motywu na stronie %s "
"będą wysyłane na ten adres."

#. translators: %s: comma separated list of addresses.
#: includes/class-notifier.php:280
#, php-format
