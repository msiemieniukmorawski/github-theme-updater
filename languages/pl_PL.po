msgstr "wersja wstępna"

#: views/tab-update.php:341
msgid "Install the selected version of the theme?"
msgstr "Zainstalować wybraną wersję motywu?"

#: views/tab-update.php:342
msgid "Installing…"
msgstr "Instalowanie…"

#: views/tab-update.php:344
msgid "Install this version"
msgstr "Zainstaluj tę wersję"

#: views/tab-update.php:351
msgid "Recent operations"
msgstr "Ostatnie operacje"

#. translators: %s: number of entries kept in the log.
#: views/tab-update.php:356
#, php-format
msgid ""
"Up to %s most recent updates and restores, newest first. Failed attempts are "
