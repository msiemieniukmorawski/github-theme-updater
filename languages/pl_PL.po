msgstr "Nowa wersja: %s"

#. translators: %s: date and time.
#: includes/class-notifier.php:339
#, php-format
msgid "When: %s"
msgstr "Kiedy: %s"

#. translators: %s: version.
#: includes/class-notifier.php:357
#, php-format
